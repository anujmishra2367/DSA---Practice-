class Solution {
  public:
    int countAlwaysFound(vector<int>& arr){
      int n=arr.size();
      vector<int> mini(n);

      mini[n-1]=INT_MAX;
      for(int i=n-2; i>=0; i--) mini[i]=min(mini[i+1], arr[i+1]);


      int ans=0;

      int mx=INT_MIN;
      for(int i=0; i<n; i++){
        if(arr[i]>mx && arr[i]<mini[i]) ans++;
        mx=max(mx, arr[i]);
      }

      return ans; 
    }
};
